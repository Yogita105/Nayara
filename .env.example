# Backend settings. Copy to backend/.env for local work, and set the same
# names as secrets on your host in production. Never commit real values.

# --- Required everywhere -----------------------------------------------------

# MongoDB connection string.
MONGO_URL=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority

# Database name. Use a separate one locally so tests and development never
# touch live orders.
DB_NAME=Nayara_dev

# --- Required in production --------------------------------------------------

# development | test | staging | production
ENVIRONMENT=development

# Signing key for CSRF tokens. At least 32 characters, and not this value.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=

# Origins allowed to call the API. Required in production; wildcards rejected.
# Unused when the frontend is served from the same origin, which is the default.
# CORS_ORIGINS=https://nayara.in,https://www.nayara.in

# --- Access ------------------------------------------------------------------

# Mobile numbers that receive administrator access, comma separated.
ADMIN_MOBILES=9876543210

# --- Optional ----------------------------------------------------------------

# Send session cookies only over HTTPS. Forced on in production.
# COOKIE_SECURE=false

# Trust X-Forwarded-For. Enable only behind a proxy you control, or callers can
# spoof their address and evade rate limits.
# TRUST_PROXY_HEADERS=false

# DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_LEVEL=INFO

# JSON logs suit an aggregator; defaults to on in production and staging.
# LOG_JSON=false

# Starter products. On in development and test, off elsewhere.
# AUTO_SEED_PRODUCTS=true

# Interactive API documentation at /docs, /redoc and /openapi.json. On in
# development and test, off elsewhere: the schema describes the admin API.
# API_DOCS_ENABLED=false

# Connections held per worker. Workers multiply this, so keep the total well
# under your cluster's limit.
# MONGO_MAX_POOL_SIZE=20
# MONGO_TIMEOUT_MS=10000
# MONGO_SOCKET_TIMEOUT_MS=20000

# --- Image uploads -----------------------------------------------------------

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
